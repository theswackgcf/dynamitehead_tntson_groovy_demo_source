function scr_dg_speedrun(act = 0){
	switch(act){
		case 0:
			_textarray = [
				["I knew I shouldn't have bought these cheap... KNOCKOFF SPEAKERS!", "lanky", false],
			];
		break;
		case 1:
			_textarray = [
				["Why'd they even make them so heavy anyway?!", "lanky", false],
			];
		break;
		case 2:
			_textarray = [
				["I just hope nobody's around to see me like this!!", "lanky", false],
			];
		break;
		case 3:
			_textarray = [
				["Next time I'm getting a boombox, alright.", "lanky", false],
			];
		break;
		case 4:
			_textarray = [
				["STUPID SPEAKERS!", "lanky", false],
			];
		break;
		case 5:
			_textarray = [
				["Okay.", "dh", false],
			];
		break;
		case 6:
			_textarray = [
				["Oh. You're here.", "lanky", true],
				["Hey, game. Cue the battle already.", "dh", true],
			];
		break;
	}
}